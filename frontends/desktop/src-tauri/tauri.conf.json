{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm",
  "version": "0.1.0",
  "identifier": "io.github.gpbcom.swarm",
  "build": {
    "beforeBuildCommand": "pnpm --filter @swarm/ground-control --filter @swarm/mission-studio build && node --experimental-strip-types scripts/assemble.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "ground-control",
        "url": "ground-control/index.html",
        "title": "⚙️ Swarm · Ground control",
        "width": 1280,
        "height": 800
      },
      {
        "label": "mission-studio",
        "url": "mission-studio/index.html",
        "title": "⚙️ Swarm · Mission studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
