# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code worktrees of the ticket harness
.claude/worktrees/

# Terraform state, variables and plans stay outside the repository
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
*.tfbackend
# Only cell roots commit their provider lock
deploy/terraform/modules/**/.terraform.lock.hcl

# Rust build output
packages/rust/target/

# Node
node_modules/
.turbo/

# Log files written by the logging configuration stay out of the repository
logs/

# Editor settings stay local to each person.
.vscode/

# Helm dependencies are packaged on build and never committed
deploy/charts/*/charts/
.VSCodeCounter
# VS Code workspace of the open tickets, written by .claude/scripts/tickets.py workspace (TKT-16)
swarm.code-workspace
