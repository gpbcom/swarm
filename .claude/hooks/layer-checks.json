{
  "max_blocks": 2,
  "rules": [
    {
      "name": "ruff check",
      "match": "^(?:backend|scripts|tests)/.+\\.py$",
      "run": [
        "uv",
        "run",
        "ruff",
        "check",
        "{files}"
      ]
    },
    {
      "name": "ruff format",
      "match": "^(?:backend|scripts|tests)/.+\\.py$",
      "run": [
        "uv",
        "run",
        "ruff",
        "format",
        "--check",
        "{files}"
      ]
    },
    {
      "name": "mypy {1}",
      "match": "^backend/(swarm-[^/]+|libs/[^/]+|apps/[^/]+)/src/.+\\.py$",
      "run": [
        "uv",
        "run",
        "mypy",
        "backend/{1}/src"
      ]
    },
    {
      "name": "mypy scripts",
      "match": "^scripts/src/.+\\.py$",
      "run": [
        "uv",
        "run",
        "mypy",
        "scripts/src"
      ]
    },
    {
      "name": "pytest {1}/{2}",
      "match": "^backend/(?:swarm-[^/]+|libs/[^/]+|apps/[^/]+)/src/([^/]+)/(.+)/[^/]+\\.py$",
      "run": [
        "uv",
        "run",
        "pytest",
        "tests/{1}/{2}",
        "-n",
        "2"
      ],
      "needs": "tests/{1}/{2}",
      "skip_when_only_tests": true
    },
    {
      "name": "pytest scripts/{1}",
      "match": "^scripts/src/swarm_scripts/(.+)/[^/]+\\.py$",
      "run": [
        "uv",
        "run",
        "pytest",
        "tests/scripts/{1}",
        "-n",
        "2"
      ],
      "needs": "tests/scripts/{1}",
      "skip_when_only_tests": true
    },
    {
      "name": "pytest harness {1}",
      "match": "^\\.claude/(?:hooks|scripts|skills/[^/]+/scripts)/([^/]+)\\.py$",
      "run": [
        "uv",
        "run",
        "pytest",
        "tests/harness/{1}",
        "-n",
        "2"
      ],
      "needs": "tests/harness/{1}",
      "skip_when_only_tests": true
    },
    {
      "name": "cargo fmt {1}",
      "match": "^rust/([^/]+)/",
      "run": [
        "cargo",
        "fmt",
        "--check",
        "--manifest-path",
        "rust/{1}/Cargo.toml"
      ],
      "needs": "rust/{1}/Cargo.toml",
      "skip_when_only_tests": true
    },
    {
      "name": "cargo clippy {1}",
      "match": "^rust/([^/]+)/",
      "run": [
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/{1}/Cargo.toml",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "needs": "rust/{1}/Cargo.toml",
      "skip_when_only_tests": true
    },
    {
      "name": "cargo test {1}",
      "match": "^rust/([^/]+)/",
      "run": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/{1}/Cargo.toml"
      ],
      "needs": "rust/{1}/Cargo.toml",
      "skip_when_only_tests": true
    },
    {
      "name": "pnpm lint {1}/{2}",
      "match": "^(frontend/apps|frontend/packages)/([^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}/{2}",
        "run",
        "--if-present",
        "lint"
      ],
      "needs": "{1}/{2}/package.json"
    },
    {
      "name": "pnpm typecheck {1}/{2}",
      "match": "^(frontend/apps|frontend/packages)/([^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}/{2}",
        "run",
        "--if-present",
        "typecheck"
      ],
      "needs": "{1}/{2}/package.json"
    },
    {
      "name": "pnpm test {1}/{2}",
      "match": "^(frontend/apps|frontend/packages)/([^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}/{2}",
        "run",
        "--if-present",
        "test"
      ],
      "needs": "{1}/{2}/package.json",
      "skip_when_only_tests": true
    },
    {
      "name": "terraform fmt {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "fmt",
        "-check",
        "-recursive",
        "{1}"
      ]
    },
    {
      "name": "terraform init {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "init",
        "-backend=false",
        "-input=false"
      ],
      "skip_when_only_tests": true
    },
    {
      "name": "terraform validate {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "validate"
      ],
      "skip_when_only_tests": true
    },
    {
      "name": "terraform test {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "test"
      ],
      "needs": "{1}/tests",
      "skip_when_only_tests": true
    },
    {
      "name": "specs check",
      "match": "^(?:docs/specs/|\\.claude/skills/write-specs/)",
      "run": [
        "python3",
        ".claude/skills/write-specs/scripts/specs.py",
        "check"
      ]
    },
    {
      "name": "check_ticket {1}",
      "match": "^docs/tickets/(T\\d\\.\\d{2})/TICKET\\.md$",
      "run": [
        "python3",
        ".claude/skills/ticket/scripts/check_ticket.py",
        "{1}"
      ]
    },
    {
      "name": "check_plan {1}",
      "match": "^docs/tickets/(T\\d\\.\\d{2})/PLAN\\.md$",
      "run": [
        "python3",
        ".claude/skills/ticket/scripts/check_plan.py",
        "{1}"
      ]
    }
  ]
}
