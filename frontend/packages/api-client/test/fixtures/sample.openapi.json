{
  "openapi": "3.1.0",
  "info": { "title": "Sample", "version": "0.1.0" },
  "paths": {
    "/v1/samples": {
      "post": {
        "operationId": "create_sample",
        "responses": {
          "default": {
            "description": "Problem",
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        },
        "required": ["type", "title", "status"]
      }
    }
  }
}
