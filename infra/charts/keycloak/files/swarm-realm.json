  "browserFlow": "swarm browser",
  "authenticationFlows": [
    {
      "alias": "swarm browser",
      "description": "Browser flow with a second factor for the staff roles",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser forms"
        }
      ]
    },
    {
      "alias": "swarm browser forms",
      "description": "Username, password and second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser pilot otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser mission_planner otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser fleet_maintainer otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 50,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser instructor otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 60,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "authenticatorFlow": true,
          "flowAlias": "swarm browser swarm_administrator otp"
        }
      ]
    },
    {
      "alias": "swarm browser pilot otp",
      "description": "Second factor for pilot",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "swarm mfa pilot"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
