{
  "realm": "swarm",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "roles": {
    "realm": [
      {
        "name": "pilot",
        "description": "Swarm role pilot",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "mission_planner",
        "description": "Swarm role mission_planner",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "fleet_maintainer",
        "description": "Swarm role fleet_maintainer",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "instructor",
        "description": "Swarm role instructor",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "client",
        "description": "Swarm role client",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "site_agent",
        "description": "Swarm role site_agent",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "swarm_administrator",
        "description": "Swarm role swarm_administrator",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "sub",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "swarm",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "operator_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "operator_id",
            "claim.name": "operator_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "swarm-gateway audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "swarm-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ground-control",
